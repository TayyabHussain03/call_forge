# ---------------------------------------------------------------------------
# Outbound Agent - environment configuration TEMPLATE
#
# Isko copy karke `.env` bana lo:  cp .env.example .env
# Phir apni real values bharo. `.env` kabhi commit mat karna (gitignored).
# Har key `app/config/settings.py` ke Settings model se map hoti hai.
# ---------------------------------------------------------------------------

# ── App ──
APP_ENV=local                 # local | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ── Database ──
# SQLite (default, local). Postgres par jaane ke liye sirf ye URL badalna hai, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/outbound
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_ECHO=false                 # true karo to SQL queries console par print hongi (debug)

# ── LLM (Gemini — abhi ka default provider) ──
LLM_PROVIDER=gemini           # provider_factory isse decide karega
GEMINI_API_KEY=your-gemini-key-here
LLM_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=15

# ── Voice platform (Vapi) — abhi optional, baad mein use hoga ──
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ── Queue (Redis) — workers ke liye, baad mein ──
REDIS_URL=redis://localhost:6379/0

# ── Conversation config file path ──
CONVERSATION_CONFIG_PATH=app/config/conversation_config.yaml
PROMPTS_DIR=app/config/prompts
